# Your Zendesk subdomain. For https://acme.zendesk.com this is "acme".
ZENDESK_SUBDOMAIN=xxx

# --- OAuth (recommended) ---------------------------------------------------
# Identifier of a *public* OAuth client from Admin Center
# (Apps and integrations > APIs > OAuth clients). There is no client secret:
# this server runs on the operator's own machine and uses PKCE instead.
# After setting this, run `uv run zendesk-auth` once to authorize.
ZENDESK_CLIENT_ID=

# Optional. Defaults to the scopes every tool in this server needs.
# ZENDESK_OAUTH_SCOPES=tickets:read tickets:write ticket_attachments:read users:read hc:read

# Optional. Must exactly match a redirect URL registered on the OAuth client.
# ZENDESK_OAUTH_REDIRECT_URI=http://localhost:4567/callback

# Optional. Defaults to $XDG_CONFIG_HOME/zendesk-mcp/tokens.json
# (~/.config/zendesk-mcp/tokens.json). Keep it out of version control.
# ZENDESK_TOKEN_FILE=

# --- API token (deprecated) ------------------------------------------------
# Zendesk stops accepting API tokens on 2027-04-30 and blocks creating new ones
# from 2026-10-27. An API token also grants this server everything its user can
# do, regardless of who is using the server. Leave these unset when using OAuth.
# ZENDESK_EMAIL=xxx
# ZENDESK_API_KEY=xxx
