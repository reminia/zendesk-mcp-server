# =============================================================================
# Zendesk MCP Server Configuration
# =============================================================================
# This server supports two authentication modes:
#
# 1. LOCAL MODE (API Key) - for development/single-user use
#    Run with: uv run zendesk
#
# 2. REMOTE MODE (OAuth) - for production/multi-user use
#    Run with: uv run zendesk-remote
#
# Configure the appropriate section below based on your use case.
# =============================================================================

# =============================================================================
# LOCAL MODE: API Key Authentication
# =============================================================================
# Use these settings when running the local stdio-based server.
# Get your API token from: Admin Center > Apps and integrations > APIs > Zendesk API

ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=your-email@example.com
ZENDESK_API_KEY=your-api-token

# =============================================================================
# REMOTE MODE: OAuth 2.0 Authentication
# =============================================================================
# Use these settings when running the HTTP-based server with OAuth.
# Register your OAuth app in: Admin Center > Apps and integrations > APIs > OAuth clients

# OAuth Application Credentials
ZENDESK_OAUTH_CLIENT_ID=your-oauth-client-id
ZENDESK_OAUTH_CLIENT_SECRET=your-oauth-client-secret
ZENDESK_OAUTH_REDIRECT_URI=https://your-server.com/oauth/callback

# OAuth Scopes (comma-separated)
# Available scopes: read, write, impersonate, tickets:read, tickets:write, etc.
ZENDESK_OAUTH_SCOPES=read,write

# =============================================================================
# HTTP Server Configuration (Remote Mode Only)
# =============================================================================

# Server binding
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8080

# Public-facing URL (used for OAuth callbacks and MCP discovery)
MCP_SERVER_BASE_URL=https://your-server.com

# CORS allowed origins (comma-separated, use * for all)
MCP_CORS_ORIGINS=*

# =============================================================================
# Security Configuration (Remote Mode Only)
# =============================================================================

# Session secret for signing (auto-generated if not set, but should be fixed in production)
MCP_SESSION_SECRET=your-secure-random-string

# Token encryption key (Fernet key for encrypting stored OAuth tokens)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-fernet-encryption-key

# =============================================================================
# Database Configuration (Remote Mode Only)
# =============================================================================
# SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///zendesk_mcp_tokens.db

# PostgreSQL (requires installing with: pip install zendesk-mcp-server[postgres])
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/zendesk_mcp

# =============================================================================
# General Settings
# =============================================================================

# Request timeout in seconds
ZENDESK_TIMEOUT=30
